        self.use_lazy_leg    = True
        self.max_lazy_legs   = 2
        # ─────────────────────────────────────────────────────────────────────

        # ── PER-WINDOW CONFIG ────────────────────────────────────────────────
        self.candle_windows = [
            {"start_hour": 9,  "start_minute": 35, "duration_minutes": 5,
             "premium_target": 6.0, "stop_pct": 53.0, "call_profit_pct": 150.0, "put_profit_pct": 250.0},

            {"start_hour": 9,  "start_minute": 35, "duration_minutes": 11,
             "premium_target": 6.0, "stop_pct": 33.0, "call_profit_pct": 150.0, "put_profit_pct": 250.0},

            {"start_hour": 9,  "start_minute": 35, "duration_minutes": 15,
            "premium_target": 6.0, "stop_pct": 33.0, "call_profit_pct": 150.0, "put_profit_pct": 250.0},

             #{"start_hour": 9, "start_minute": 45,  "duration_minutes": 5,
             #"premium_target": 6.0, "stop_pct": 53.0, "call_profit_pct": 250.0, "put_profit_pct": 350.0},

             #{"start_hour": 10, "start_minute": 0,  "duration_minutes": 5,
             #"premium_target": 8.0, "stop_pct": 53.0, "call_profit_pct": 250.0, "put_profit_pct": 350.0},
            ##updated##
            # {"start_hour": 9, "start_minute": 45,  "duration_minutes": 11,
            # "premium_target": 6.0, "stop_pct": 53.0, "call_profit_pct": 250.0, "put_profit_pct": 350.0},

            # {"start_hour": 10, "start_minute": 0,  "duration_minutes": 11,
            # "premium_target": 8.0, "stop_pct": 23.0, "call_profit_pct": 250.0, "put_profit_pct": 350.0},

            # {"start_hour": 10, "start_minute": 30,  "duration_minutes": 5,
            #  "premium_target": 9.0, "stop_pct": 43.0, "call_profit_pct": 250.0, "put_profit_pct": 350.0},

            #{"start_hour": 10, "start_minute": 30,  "duration_minutes": 11,
            #"premium_target": 9.0, "stop_pct": 43.0, "call_profit_pct": 250.0, "put_profit_pct": 350.0},
        ]

        # ── EXIT TIMINGS (BTST vs INTRADAY) ─────────────────────────────────────
        if self.MODE == "BTST":
            self.hold_overnight   = True
            self.etx_hour         = 9
            self.etx_minute       = 34       
            self.safety_flat_on   = False
        else:
            self.hold_overnight   = False
            self.etx_hour         = 15
            self.etx_minute       = 40       
            self.safety_flat_on   = True

        # ── DAY FILTER ──────────────────────────────────────────────────────────
        self.DAY_FILTER = "NONE"
        self._day_filter_map = {"MON": 0, "TUE": 1, "WED": 2, "THU": 3, "FRI": 4}

        # ── SPX INDEX (underlying) ──────────────────────────────────────────────
        idx = self.add_index("SPX", Resolution.MINUTE)
        self.underlying = idx.symbol

        # ── SPXW WEEKLY INDEX OPTIONS ───────────────────────────────────────────
        opt = self.add_index_option(self.underlying, "SPXW", Resolution.MINUTE)
        opt.set_filter(lambda u: u.include_weeklys().strikes(-15, 15).expiration(0, 3))
        self.option_symbol = opt.symbol

        self.slip_model    = ConstantSlippageModel(self.slippage_amount)
        self.wins          = {}
        self.o2k           = {}

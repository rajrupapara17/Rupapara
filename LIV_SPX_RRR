class SPX_RangeBreakout_MultiCandle(QCAlgorithm):

    def initialize(self):
        self.set_time_zone("America/New_York")
        self.set_cash(100000)
        self.set_start_date(2026, 5, 17)
        #self.set_end_date(2026, 1, 1)

        self.MODE            = "INTRADAY"    # "INTRADAY"-6 or "BTST-5,8"
        self.premium_target  = 6.0           # global default premium
        self.tolerance       = 0.50          # premium tolerance for selection
        self.profit_pct      = 500.0         # global default profit %
        self.qty             = 1             # quantity for breakout entries
        self.stop_price_mode = "MID"
        self.slippage_amount = 0.00

        self.stop_loss_mode  = "PERCENT"   
        self.stop_pct        = 33.0          # global default stop %

        self.use_underlying_candle_stop = False
        self.use_dynamic_size = False
        self.risk_pct         = 1.0
        self.use_asymmetric_targets = True
        self.call_profit_pct  = 300.0        # global default call profit %
        self.put_profit_pct   = 500.0        # global default put profit %
        self.use_breakeven          = False
        self.breakeven_trigger_pct  = 100.0
        self.use_trailing_stop      = False
        self.trailing_stop_pct      = 50.0


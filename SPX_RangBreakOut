from AlgorithmImports import *
from datetime import datetime, timedelta
from QuantConnect.Orders.Slippage import ConstantSlippageModel
from QuantConnect.Orders.Fills import ImmediateFillModel
import math


class SPX_RangeBreakout_FirstHourCandle(QCAlgorithm):

    def initialize(self):
        self.set_time_zone("America/New_York")
        self.set_cash(1000000)
        self.set_start_date(2020, 1, 1)
        # self.set_end_date(2025, 12, 1)

        self.MODE            = "INTRADAY"        # "INTRADAY" or "BTST"
        self.premium_target  = 3.0           # target premium for both call & put selection
        self.tolerance       = 0.50          # premium tolerance for selection
        self.profit_pct      = 3000000.0         # profit booking % above 1-hr high
        self.qty             = 1             # quantity for breakout entries
        self.stop_price_mode = "MID"
        self.slippage_amount = 0.00

        # ── CANDLE DURATION ─────────────────────────────────────────────────────
        # Set how many minutes the breakout candle lasts.
        # The candle starts at candle_start_hour:candle_start_minute and ends
        # exactly `candle_minutes` minutes later. Common values: 15, 30, 60.
        self.candle_start_hour    = 10
        self.candle_start_minute  = 00
        self.candle_minutes       = 15   # 60 = 1-hour candle, 30 = 30-min, 15 = 15-min, etc.
        # ────────────────────────────────────────────────────────────────────────

        # ── STOP LOSS MODE ──────────────────────────────────────────────────────
        # "CANDLE_LOW" → stop is set to the candle's low price (default behavior).
        #                Exit when contract's price drops below the candle low.
        # "PERCENT"    → stop is set to entry_fill * (1 - stop_pct / 100).
        #                Exit when contract drops by stop_pct % from fill price.
        self.stop_loss_mode = "PERCENT"  # "CANDLE_LOW" or "PERCENT"
        self.stop_pct       = 62.0           # used only when stop_loss_mode = "PERCENT"
        # ────────────────────────────────────────────────────────────────────────

        # ── EXIT TIMINGS (BTST vs INTRADAY) ─────────────────────────────────────
        if self.MODE == "BTST":
            self.hold_overnight   = True
            self.etx_hour         = 9
            self.etx_minute       = 34       # next-day morning exit for any open positions
            self.safety_flat_on   = False
        else:
            self.hold_overnight   = False
            self.etx_hour         = 15
            self.etx_minute       = 50       # same-day exit
            self.safety_flat_on   = True
        # ────────────────────────────────────────────────────────────────────────

        # Compute candle_end from candle_start + candle_minutes
        total_start_min = self.candle_start_hour * 60 + self.candle_start_minute
        total_end_min   = total_start_min + int(self.candle_minutes)
        self.candle_end_hour    = total_end_min // 60
        self.candle_end_minute  = total_end_min % 60

        # ── DAY FILTER ──────────────────────────────────────────────────────────
        self.DAY_FILTER = "NONE"   # "MON", "TUE", "WED", "THU", "FRI", "NONE"
        self._day_filter_map = {"MON": 0, "TUE": 1, "WED": 2, "THU": 3, "FRI": 4}
        # ────────────────────────────────────────────────────────────────────────

        # ── SPX INDEX (underlying) ──────────────────────────────────────────────
        idx = self.add_index("SPX", Resolution.MINUTE)
        self.underlying = idx.symbol

        # ── SPXW WEEKLY INDEX OPTIONS ───────────────────────────────────────────
        opt = self.add_index_option(self.underlying, "SPXW", Resolution.MINUTE)
        opt.set_filter(lambda u: u.include_weeklys().strikes(-15, 15).expiration(0, 3))
        self.option_symbol = opt.symbol

        self.slip_model    = ConstantSlippageModel(self.slippage_amount)
        self.legs          = {}
        self.o2k           = {}
        self.allow_entries = False
        self.trading_day   = None
        self.etx_fired     = False
        self.chain_cache   = None
        self._selected_today = False

        self.schedule.on(self.date_rules.every_day(self.underlying),
                         self.time_rules.at(9, 30), self._reset)
        self.schedule.on(self.date_rules.every_day(self.underlying),
                         self.time_rules.at(self.candle_start_hour, self.candle_start_minute),
                         self._select_contracts)
        self.schedule.on(self.date_rules.every_day(self.underlying),
                         self.time_rules.at(self.candle_end_hour, self.candle_end_minute),
                         self._lock_candle_and_arm)
        self.schedule.on(self.date_rules.every_day(self.underlying),
                         self.time_rules.at(self.etx_hour, self.etx_minute), self._etx)
        self.schedule.on(self.date_rules.every_day(self.underlying),
                         self.time_rules.at(15, 55), self._prevent_assign)
        self.schedule.on(self.date_rules.every_day(self.underlying),
                         self.time_rules.every(timedelta(minutes=1)), self._per_minute)
        if self.safety_flat_on:
            self.schedule.on(self.date_rules.every_day(self.underlying),
                             self.time_rules.at(15, 40), self._safety_flat)

        self.log(f"[INIT] candle window {self.candle_start_hour:02d}:{self.candle_start_minute:02d} → "
                 f"{self.candle_end_hour:02d}:{self.candle_end_minute:02d} ({self.candle_minutes} min) | "
                 f"stop_mode={self.stop_loss_mode}")

    # ── helpers ──────────────────────────────────────────────────────────────

    def _is_option_security(self, sym):
        """Helper: SPX uses INDEX_OPTION, equities use OPTION. Treat both."""
        return sym.security_type in (SecurityType.OPTION, SecurityType.INDEX_OPTION)

    def _is_entry_day_allowed(self):
        if self.DAY_FILTER is None or self.DAY_FILTER == "NONE":
            return True
        target_weekday = self._day_filter_map.get(self.DAY_FILTER.upper())
        if target_weekday is None:
            return True
        return self.time.date().weekday() == target_weekday

    def _new_leg(self, side, contract, init_px):
        return dict(
            side=side,
            contract=contract,
            init_px=float(init_px),
            sel_date=self.time.date(),
            candle_high=None,
            candle_low=None,
            candle_locked=False,
            armed=False,
            prev=None,
            entered=False,
            pending=False,
            qty=0,
            fill=None,
            stop=None,
            profit_target=None,
            stop_fired=False,
            profit_fired=False,
        )

    # ─────────────────────────────────────────────────────────────────────────

    def _reset(self):
        self.transactions.cancel_open_orders()
        new_legs = {}
        for k, leg in self.legs.items():
            if leg.get("qty", 0) > 0 or leg.get("pending"):
                new_legs[k] = leg
        self.legs = new_legs
        self.etx_fired       = False
        self.allow_entries   = False
        self.trading_day     = self.time.date()
        self._selected_today = False
        self.log(f"[RESET] daily reset at {self.time}")

    def _select_contracts(self):
        today = self.time.date()
        self.allow_entries = True
        self.trading_day   = today

        if not self._is_entry_day_allowed():
            self.log(f"[SELECT] skipped — day filter blocks {today}")
            return

        if self._selected_today:
            return
        if not self.chain_cache:
            self.log(f"[SELECT] chain cache not ready at {self.time}")
            return

        if self.hold_overnight:
            delta = {4: 3, 5: 2}.get(today.weekday(), 1)
            target_d = today + timedelta(delta)
        else:
            target_d = today

        candidates = [c for c in self.chain_cache
                      if hasattr(c, 'expiry') and c.expiry.date() == target_d]
        if not candidates:
            self.log(f"[SELECT-MISS] no contracts for expiry {target_d}")
            return

        calls = [c for c in candidates if c.right == 0]
        puts  = [c for c in candidates if c.right == 1]

        call_pick, call_mid = self._pick_closest_to_target(calls, self.premium_target)
        put_pick,  put_mid  = self._pick_closest_to_target(puts,  self.premium_target)

        if call_pick is None and put_pick is None:
            self.log(f"[SELECT-MISS] no call AND no put within tolerance at {self.time}")
            return

        if call_pick is not None:
            self.add_index_option_contract(call_pick.symbol, Resolution.MINUTE)
            sec = self.securities.get(call_pick.symbol)
            if sec:
                sec.set_slippage_model(self.slip_model)
                sec.fill_model = ImmediateFillModel()
            key = "CALL"
            self.legs[key] = self._new_leg("CALL", call_pick.symbol, call_mid)
            self.log(f"[SELECT-CALL] {call_pick.symbol} mid={call_mid:.2f} (candle tracking begins)")

        if put_pick is not None:
            self.add_index_option_contract(put_pick.symbol, Resolution.MINUTE)
            sec = self.securities.get(put_pick.symbol)
            if sec:
                sec.set_slippage_model(self.slip_model)
                sec.fill_model = ImmediateFillModel()
            key = "PUT"
            self.legs[key] = self._new_leg("PUT", put_pick.symbol, put_mid)
            self.log(f"[SELECT-PUT] {put_pick.symbol} mid={put_mid:.2f} (candle tracking begins)")

        self._selected_today = True

    def _pick_closest_to_target(self, contracts, target):
        if not contracts:
            return None, None
        sorted_c = sorted(contracts, key=lambda c: abs(self._mid(c) - target))
        for c in sorted_c:
            mp = self._mid(c)
            if mp > 0 and abs(mp - target) <= self.tolerance:
                return c, mp
        return None, None

    def _lock_candle_and_arm(self):
        for k, leg in self.legs.items():
            if leg.get("entered") or leg.get("pending"):
                continue
            if leg.get("candle_high") is None or leg.get("candle_low") is None:
                self.log(f"[CANDLE-LOCK-MISS] {k} no candle data, skipping")
                continue
            leg["candle_locked"] = True
            leg["armed"]         = True
            leg["prev"]          = None
            self.log(f"[CANDLE-LOCK] {k} high={leg['candle_high']:.2f} low={leg['candle_low']:.2f}")

    def _etx(self):
        self.log(f"[ETX] fired at {self.time}, etx_fired set True")
        self.etx_fired     = True
        self.allow_entries = False
        self.trading_day   = self.time.date()
        self._exit_all("ETX_EXIT")

    def _prevent_assign(self):
        today = self.time.date()
        for sym, h in self.portfolio.items():
            if h.invested and self._is_option_security(sym) and sym.id.date.date() <= today:
                self.liquidate(sym, "PREVENT_ASSIGN")

    def _safety_flat(self):
        self.allow_entries = False
        self.trading_day   = self.time.date()
        self._exit_all("SAFETY_FLAT")

    def _has_open_options(self):
        return any(h.invested and self._is_option_security(sym)
                   for sym, h in self.portfolio.items())

    def _exit_all(self, tag):
        for leg in self.legs.values():
            leg["pending"] = False
            leg["armed"]   = False
            leg["qty"]     = 0
        for sym, h in self.portfolio.items():
            qty = int(h.quantity)
            if sym.security_type == SecurityType.EQUITY and qty:
                self.liquidate(sym, "UNWANTED_EQ")
            elif self._is_option_security(sym) and qty > 0:
                if not any(o.direction == OrderDirection.SELL
                           for o in self.transactions.get_open_orders(sym)):
                    self.market_order(sym, -qty, False, tag)

    def _per_minute(self):
        for k, leg in list(self.legs.items()):
            if not leg.get("entered") or leg.get("stop_fired") or leg.get("profit_fired"):
                continue
            sym = leg.get("contract")
            if not sym or sym not in self.portfolio or not self.portfolio[sym].invested:
                continue
            actual = int(self.portfolio[sym].quantity)
            if actual <= 0:
                continue
            sec = self.securities.get(sym)
            if sec and sec.has_data:
                px = self._sec_stop_px(sec)
                if px > 0 and leg.get("stop") and px <= leg["stop"]:
                    self._fire_stop(k, leg, sym, actual)
                elif px > 0 and leg.get("profit_target") and px >= leg["profit_target"]:
                    self._fire_profit(k, leg, sym, actual)

        if self.etx_fired:
            if self._has_open_options():
                self._exit_all("ETX_RETRY")
            else:
                self.etx_fired = False

    def _fire_stop(self, key, leg, contract, qty):
        leg["stop_fired"] = True
        leg["armed"]      = False
        if leg.get("pending"):
            leg["pending"] = False
        if qty > 0:
            t = self.market_order(contract, -qty, False, f"STOP_{key}")
            if t: self.o2k[t.order_id] = key
        leg["qty"] = 0
        self.log(f"[STOP] {key} stop hit ({self.stop_loss_mode}), exited {qty}")

    def _fire_profit(self, key, leg, contract, qty):
        leg["profit_fired"] = True
        leg["armed"]        = False
        if leg.get("pending"):
            leg["pending"] = False
        if qty > 0:
            t = self.market_order(contract, -qty, False, f"PROFIT_{key}")
            if t: self.o2k[t.order_id] = key
        leg["qty"] = 0
        self.log(f"[PROFIT] {key} hit profit target, exited {qty}")

    # ─────────────────────────────────────────────────────────────────────────

    def on_data(self, data: Slice):
        today = self.time.date()

        for sym, h in self.portfolio.items():
            if h.invested and sym.security_type == SecurityType.EQUITY:
                self.liquidate(sym, "FALLBACK_EQ")

        chain_now = data.option_chains.get(self.option_symbol)
        if chain_now:
            cl = list(chain_now)
            if cl:
                if self.chain_cache is None:
                    self.log(f"[CHAIN] first loaded at {self.time}, size={len(cl)}")
                self.chain_cache = cl

        if not self.legs:
            return

        t_now = self.time
        in_candle_window = self._is_in_candle_window(t_now)
        past_candle_end  = self._is_past_candle_end(t_now)
        past_etx         = self._is_past_etx(t_now)

        if self.MODE == "INTRADAY":
            etx_block = self.etx_fired or past_etx
        else:
            etx_block = self.etx_fired

        for k, leg in self.legs.items():
            sym = leg.get("contract")
            if not sym:
                continue

            bid, ask, last, mid = self._marks(sym, data)
            if bid <= 0 and ask <= 0 and last <= 0:
                continue
            mark = mid or last
            if not mark:
                continue

            # Update candle high/low while in candle-build window
            if in_candle_window and not leg.get("candle_locked"):
                if leg.get("candle_high") is None or mark > leg["candle_high"]:
                    leg["candle_high"] = mark
                if leg.get("candle_low") is None or mark < leg["candle_low"]:
                    leg["candle_low"] = mark

            # Breakout entry
            if leg.get("armed") and not leg.get("entered") and not leg.get("pending") \
               and past_candle_end and not etx_block and self.allow_entries \
               and self.trading_day == today:
                if leg.get("prev") is None:
                    leg["prev"] = mark
                else:
                    candle_high = leg.get("candle_high")
                    if candle_high is not None and leg["prev"] < candle_high <= mark:
                        self._fire_breakout_entry(k, leg, mark)
                    leg["prev"] = mark

    def _fire_breakout_entry(self, key, leg, mark):
        sym = leg.get("contract")
        if not sym:
            return
            
        candle_high = leg.get("candle_high")
        candle_low  = leg.get("candle_low")
        
        # Pre-calculate targets BEFORE submitting the order to avoid the NoneType formatting error
        leg["profit_target"] = candle_high * (1 + self.profit_pct / 100)
        
        mode = str(self.stop_loss_mode).strip().upper()
        if mode == "PERCENT":
            # Tentative stop (relative to mark); re-anchored to fill price on fill
            leg["stop"] = mark * (1 - self.stop_pct / 100)
        else:
            leg["stop"] = candle_low
            
        leg["pending"] = True
        leg["armed"]   = False
        leg["stop_fired"]    = False
        leg["profit_fired"]  = False

        # Submit the order (on_order_event will synchronously fire right here)
        t = self.market_order(sym, self.qty, False, f"BREAKOUT_ENTRY_{key}")
        if t:
            self.o2k[t.order_id] = key
            
        self.log(f"[BREAKOUT] {key} cross-up high={candle_high:.2f} mark={mark:.2f} "
                 f"low={candle_low:.2f} stop={leg['stop']:.2f} target={leg['profit_target']:.2f}")

    def on_order_event(self, oe: OrderEvent):
        # Fallback to symbol lookup because ImmediateFillModel can fire synchronously 
        # before the ticket is mapped in self.o2k
        key = self.o2k.get(oe.order_id)
        if key is None:
            for k, l in self.legs.items():
                if l.get("contract") == oe.symbol:
                    key = k
                    break
                    
        leg = self.legs.get(key) if key is not None else None
        if leg is None:
            return
            
        if oe.status == OrderStatus.CANCELED:
            if oe.direction == OrderDirection.BUY:
                leg["pending"] = False
            return
            
        if oe.status != OrderStatus.FILLED or float(oe.fill_price) <= 0:
            return
            
        fp, fq = float(oe.fill_price), int(oe.fill_quantity)
        if oe.direction == OrderDirection.BUY:
            leg["qty"]     += fq
            leg["fill"]     = fp
            leg["pending"]  = False
            leg["entered"]  = True
            
            # Re-anchor stop to actual fill price if using PERCENT mode
            mode = str(self.stop_loss_mode).strip().upper()
            if mode == "PERCENT":
                leg["stop"] = fp * (1 - self.stop_pct / 100)
                
            self.log(f"[FILL-BUY] {key} fill={fp:.2f} qty={fq} stop={leg['stop']:.2f} "
                     f"target={leg['profit_target']:.2f}")
        else:
            leg["qty"] = max(0, leg["qty"] + fq)

    # ── time helpers ─────────────────────────────────────────────────────────

    def _is_in_candle_window(self, t):
        start_minutes = self.candle_start_hour * 60 + self.candle_start_minute
        end_minutes   = self.candle_end_hour * 60 + self.candle_end_minute
        cur_minutes   = t.hour * 60 + t.minute
        return start_minutes <= cur_minutes < end_minutes

    def _is_past_candle_end(self, t):
        end_minutes = self.candle_end_hour * 60 + self.candle_end_minute
        cur_minutes = t.hour * 60 + t.minute
        return cur_minutes >= end_minutes

    def _is_past_etx(self, t):
        etx_minutes = self.etx_hour * 60 + self.etx_minute
        cur_minutes = t.hour * 60 + t.minute
        return cur_minutes >= etx_minutes

    # ── price helpers ────────────────────────────────────────────────────────

    def _mid(self, c):
        b = float(c.bid_price or 0); a = float(c.ask_price or 0); l = float(c.last_price or 0)
        return 0.5*(b+a) if b>0 and a>0 else (l or 0)

    def _marks(self, sym, data):
        chain = data.option_chains.get(self.option_symbol)
        if chain:
            for c in chain:
                if c.symbol == sym:
                    b = float(c.bid_price or 0); a = float(c.ask_price or 0); l = float(c.last_price or 0)
                    return b, a, l, (0.5*(b+a) if b>0 and a>0 else (l or 0))
        sec = self.securities.get(sym)
        if sec and sec.has_data:
            b = float(sec.bid_price or 0); a = float(sec.ask_price or 0); l = float(sec.price or 0)
            return b, a, l, (0.5*(b+a) if b>0 and a>0 else (l or 0))
        return 0, 0, 0, 0

    def _stop_px(self, b, a, l, m):
        return (b or m or l) if self.stop_price_mode == "BID" else (m or l or b)

    def _sec_stop_px(self, sec):
        b = float(sec.bid_price or 0); a = float(sec.ask_price or 0); l = float(sec.price or 0)
        m = 0.5*(b+a) if b>0 and a>0 else 0
        return (b or l or a) if self.stop_price_mode == "BID" else (m or l or b)
